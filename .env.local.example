# Supabase 프로젝트 설정 > API 에서 값을 복사해 .env.local 로 저장하세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# 서버 전용(절대 클라이언트로 노출 금지). 자녀 계정 프로비저닝, family 생성 등
# 서비스 역할이 필요한 관리 작업(app/api/**)에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# 자녀 PIN -> 내부 인증용 비밀번호를 결정론적으로 파생시키는 서버 전용 salt.
# openssl rand -hex 32 등으로 생성해 넣으세요. 노출되면 PIN 추측 공격에 취약해집니다.
CHILD_AUTH_SECRET=change-me-to-a-long-random-string

# 사진으로 고르기(AI 항목 매칭)에 사용하는 Azure OpenAI 리소스.
# Azure Portal > Azure OpenAI 리소스 > "키 및 엔드포인트"에서 확인.
# 서버 전용 — 절대 클라이언트로 노출 금지.
AZURE_OPENAI_ENDPOINT=https://xxxxxxxx.openai.azure.com
AZURE_OPENAI_API_KEY=xxxxxxxx
# vision + function calling 을 지원하는 모델(gpt-4o, gpt-4o-mini 등)로 만든 배포 이름.
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# "왜 이게 좋아?" 음성 녹음을 텍스트로 바꾸는 데 쓰는 Whisper 배포 이름(같은 Azure OpenAI
# 리소스에 whisper 모델로 새로 배포해야 함 — 위 gpt-4o 배포와는 별개). ENDPOINT/API_KEY는
# 위 값 그대로 재사용.
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# 푸시 알림용 VAPID 키 쌍. 아래 명령으로 한 번 생성해서 그대로 붙여넣으세요(재사용, 재생성 금지 —
# 바꾸면 기존에 구독한 브라우저들이 전부 무효화됩니다):
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# PUBLIC 키는 브라우저에서도 써야 해서 NEXT_PUBLIC_ 로 한 번 더 넣습니다(둘이 같은 값).
VAPID_PUBLIC_KEY=xxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxx
# web-push 프로토콜이 요구하는 연락처(mailto: 또는 사이트 URL). 기본값은 배포 URL.
VAPID_SUBJECT=https://twin-choice-ten.vercel.app
