# Supabase 프로젝트 설정 > API 에서 값을 복사해 .env.local 로 저장하세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# 서버 전용(절대 클라이언트로 노출 금지). 자녀 계정 프로비저닝, family 생성 등
# 서비스 역할이 필요한 관리 작업(app/api/**)에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# 자녀 PIN -> 내부 인증용 비밀번호를 결정론적으로 파생시키는 서버 전용 salt.
# openssl rand -hex 32 등으로 생성해 넣으세요. 노출되면 PIN 추측 공격에 취약해집니다.
CHILD_AUTH_SECRET=change-me-to-a-long-random-string
